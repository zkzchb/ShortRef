{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortref",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "SHORTREF_KV"
    }
  ]
}
